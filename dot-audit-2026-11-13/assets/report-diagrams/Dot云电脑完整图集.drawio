  <diagram id="01-environment-boundaries" name="图 1-1  产品能力与执行环境边界">
    <mxGraphModel dx="1400" dy="1040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5&quot;&gt;图 1-1  产品能力与执行环境边界&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#16324F;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="41" width="1300" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;line-height:1.5&quot;&gt;产品逻辑关系，非物理部署拓扑｜青色：官方说明；橙色虚线：未确认&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="85" width="1300" height="30" />
        </mxCell>
        <mxCell id="accent" value="" style="rounded=1;fillColor=#137B77;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="42" width="7" height="38" />
        </mxCell>
        <mxCell id="dot" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;Dot 代理〔官方〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;接收任务并协调执行环境&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="175" width="520" height="115" />
        </mxCell>
        <mxCell id="own" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;自有云电脑〔官方〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:24px;line-height:1.45;color:#52647A&quot;&gt;有自己的文件与浏览器会话&lt;br&gt;可供研究、文档与软件工作&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="400" width="400" height="180" />
        </mxCell>
        <mxCell id="connected" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;连接的用户电脑〔官方〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:24px;line-height:1.45;color:#52647A&quot;&gt;需连接授权与设备在线&lt;br&gt;不是自有云电脑的同一工作区&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="400" width="400" height="180" />
        </mxCell>
        <mxCell id="codex" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;Codex 云任务〔官方〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:24px;line-height:1.45;color:#52647A&quot;&gt;可使用准备好的仓库环境&lt;br&gt;不能据此认定与桌面同镜像&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="945" y="400" width="400" height="180" />
        </mxCell>
        <mxCell id="unknown" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;本实例的具体部署尚未确认&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:25px;line-height:1.45;color:#52647A&quot;&gt;供应商、区域、VM 数量、容器运行时、宿主与网络隔离层次&lt;br&gt;不能由 overlay、私有地址或 CPU 型号推定 Docker / Kubernetes&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="745" width="1040" height="150" />
        </mxCell>
        <mxCell id="own-link" style="edgeStyle=none;rounded=0;html=1;strokeColor=#137B77;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.25;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="dot" target="own">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="570" y="345" />
              <mxPoint x="255" y="345" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="connected-link" style="edgeStyle=none;rounded=0;html=1;strokeColor=#137B77;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="dot" target="connected">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="codex-link" style="edgeStyle=none;rounded=0;html=1;strokeColor=#137B77;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.75;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="dot" target="codex">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="830" y="345" />
              <mxPoint x="1145" y="345" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="scope" value="&lt;div style=&quot;line-height:1.5&quot;&gt;箭头表示官方产品能力；不表示本账号已启用全部连接，亦不表示三个独立物理服务器。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="620" width="1260" height="75" />
        </mxCell>
        <mxCell id="source" value="&lt;div style=&quot;line-height:1.5&quot;&gt;来源：[O1][O4] 产品关系；[O2][O3] 共同基础设施说明；[A #021、#024、#027] 记录。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="950" width="1280" height="60" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="02-resource-limits" name="图 2-1  可见资源与实际配额核验">
    <mxGraphModel dx="1400" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5&quot;&gt;图 2-1  可见资源与实际配额核验&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#16324F;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="41" width="1300" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;line-height:1.5&quot;&gt;蓝色：历史助手记录；橙色虚线：缺失证据；灰色：通用技术解释&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="85" width="1300" height="30" />
        </mxCell>
        <mxCell id="accent" value="" style="rounded=1;fillColor=#137B77;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="42" width="7" height="38" />
        </mxCell>
        <mxCell id="technical" value="通用 cgroup v2 机制〔技术说明，不是 Dot 已测配置〕" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=26;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="765" width="1260" height="215" />
        </mxCell>
        <mxCell id="cpu" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;CPU 可见值〔记录〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:27px;line-height:1.45;color:#52647A&quot;&gt;AMD EPYC 9V74 型号字符串&lt;br&gt;9 个逻辑 CPU；允许 CPU 0–8&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="190" width="600" height="170" />
        </mxCell>
        <mxCell id="memory" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;内存可见值〔记录〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:27px;line-height:1.45;color:#52647A&quot;&gt;总量约 9.73 GiB&lt;br&gt;当时已用 1.64 GiB；可用 8.09 GiB&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="730" y="190" width="600" height="170" />
        </mxCell>
        <mxCell id="cpu-limit" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;CPU 实际限制〔未确认〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;缺少 cpu.max 与可读父层限制&lt;br&gt;也未完成独占性与持续性能验证&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="485" width="600" height="170" />
        </mxCell>
        <mxCell id="memory-limit" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;内存硬限制〔未确认〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;缺少 memory.max 与可读父层限制&lt;br&gt;可见总量不自动等于允许使用上限&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="730" y="485" width="600" height="170" />
        </mxCell>
        <mxCell id="cpu-check" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="cpu" target="cpu-limit">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="cpu-check-label" value="需补证据，不能直接换算" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#176B99;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="239.0" y="405" width="262.0" height="28" />
        </mxCell>
        <mxCell id="mem-check" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="memory" target="memory-limit">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="mem-check-label" value="需补证据，不能直接等同" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#176B99;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="899.0" y="405" width="262.0" height="28" />
        </mxCell>
        <mxCell id="rule" value="&lt;div style=&quot;line-height:1.5&quot;&gt;CPU 时间上限 = quota / period；子级仍受父级限制。&lt;br&gt;内存须核对硬限制；若采用其他资源控制机制，应按实际实现核验。&lt;br&gt;没有原始限制与基准测试，不能认定“独占 9 核 / 10 GiB”。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="830" width="1180" height="120" />
        </mxCell>
        <mxCell id="source" value="&lt;div style=&quot;line-height:1.5&quot;&gt;来源：[A #024]；[T1] Linux cgroup v2。模型推理硬件也不能由此 CPU 视图反推。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1030" width="1280" height="55" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="03-storage-evidence" name="图 3-1  存储视图与容量统计疑点">
    <mxGraphModel dx="1400" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5&quot;&gt;图 3-1  存储视图与容量统计疑点&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#16324F;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="41" width="1300" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;line-height:1.5&quot;&gt;蓝色：记录值；橙色虚线：待解释或未确认；计算结果只用于核对口径&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="85" width="1300" height="30" />
        </mxCell>
        <mxCell id="accent" value="" style="rounded=1;fillColor=#137B77;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="42" width="7" height="38" />
        </mxCell>
        <mxCell id="overlay" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;工作区文件系统 overlay〔记录〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;不能据此确定底层物理盘或容器产品&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="330" y="175" width="740" height="110" />
        </mxCell>
        <mxCell id="capacity" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;总量与可用量〔记录〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:28px;line-height:1.45;color:#52647A&quot;&gt;总量约 62.94 GiB&lt;br&gt;可用约 59.54 GiB&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="390" width="600" height="160" />
        </mxCell>
        <mxCell id="used" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;已用量〔记录〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:28px;line-height:1.45;color:#52647A&quot;&gt;约 195 MiB；约 1%&lt;br&gt;未取得同一时刻的原始字节数&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="730" y="390" width="600" height="160" />
        </mxCell>
        <mxCell id="difference" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;差额口径待解释〔复核计算〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:25px;line-height:1.45;color:#52647A&quot;&gt;62.94 − 59.54 = 3.40 GiB，约 3,482 MiB&lt;br&gt;与“已用 195 MiB”不能直接对齐&lt;br&gt;保留空间、统计字段或上下文差异均只是候选解释&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="250" y="665" width="900" height="170" />
        </mxCell>
        <mxCell id="view1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#64788C;strokeWidth=2.3;endArrow=none;endFill=1;exitX=0.3108108108108108;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="overlay" target="capacity">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="560" y="335" />
              <mxPoint x="370" y="335" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="view2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#64788C;strokeWidth=2.3;endArrow=none;endFill=1;exitX=0.6891891891891891;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="overlay" target="used">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="840" y="335" />
              <mxPoint x="1030" y="335" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="calc1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.3111111111111111;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="capacity" target="difference">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="370" y="610" />
              <mxPoint x="530" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="calc2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.6888888888888889;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="used" target="difference">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1030" y="610" />
              <mxPoint x="870" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="tmpfs" value="&lt;div style=&quot;line-height:1.5&quot;&gt;tmpfs 的各约 4.87 GiB 是上限，不可相加为额外 RAM。&lt;br&gt;SSD / NVMe、IOPS、独享容量与数据保留承诺均未确认。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="900" width="1260" height="90" />
        </mxCell>
        <mxCell id="source" value="&lt;div style=&quot;line-height:1.5&quot;&gt;来源：[A #024]；[T2] OverlayFS；[T3] tmpfs。此差异不等于磁盘损坏或记录造假。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1080" width="1280" height="60" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="04-network-contexts" name="图 4-1  三种联网上下文与代理路径">
    <mxGraphModel dx="1400" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1240" math="0" shadow="0">
      <root>
