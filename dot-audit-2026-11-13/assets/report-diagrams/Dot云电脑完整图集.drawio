        <mxCell id="accent" value="" style="rounded=1;fillColor=#137B77;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="42" width="7" height="38" />
        </mxCell>
        <mxCell id="cloud" value="Dot 云电脑中的开发与预览〔逻辑范围，不确定具体进程拓扑〕" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=26;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="175" width="1290" height="390" />
        </mxCell>
        <mxCell id="app" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;数独 Web 服务〔记录〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;助手称已启动并打包&lt;br&gt;自动测试通过仍缺原始日志&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="cloud">
          <mxGeometry as="geometry" x="45" y="125" width="480" height="165" />
        </mxCell>
        <mxCell id="preview" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;云端预览〔用户确认〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;用户 #060 表示可以正常玩&lt;br&gt;支持当时的结果可用性&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="cloud">
          <mxGeometry as="geometry" x="765" y="125" width="480" height="165" />
        </mxCell>
        <mxCell id="user-pc" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;用户自己的电脑&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;本机 localhost 指向本机上下文&lt;br&gt;不是 Dot 中同名地址的自动映射&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="705" width="580" height="170" />
        </mxCell>
        <mxCell id="external" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;外部访问入口〔未确认〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;公网 IP、入站端口与服务授权&lt;br&gt;独立 SSH、Tailscale 及持续在线&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="750" y="705" width="580" height="170" />
        </mxCell>
        <mxCell id="preview-link" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.0;exitY=0.49696969696969695;exitPerimeter=0;entryX=1.0;entryY=0.49696969696969695;entryPerimeter=0;" edge="1" parent="1" source="preview" target="app">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="preview-link-label" value="预览访问" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#176B99;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="646.0" y="325" width="108.0" height="28" />
        </mxCell>
        <mxCell id="external-test" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="user-pc" target="external">
          <mxGeometry as="geometry" relative="1" />
