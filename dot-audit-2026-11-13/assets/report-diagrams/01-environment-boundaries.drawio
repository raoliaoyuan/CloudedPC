        <mxCell id="subtitle" value="&lt;div style=&quot;line-height:1.5&quot;&gt;产品逻辑关系，非物理部署拓扑｜青色：官方说明；橙色虚线：未确认&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
