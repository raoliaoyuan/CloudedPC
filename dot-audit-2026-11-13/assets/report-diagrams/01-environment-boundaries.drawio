        </mxCell>
        <mxCell id="dot" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;Dot 代理〔官方〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;接收任务并协调执行环境&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="175" width="520" height="115" />
        </mxCell>
        <mxCell id="own" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;自有云电脑〔官方〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:24px;line-height:1.45;color:#52647A&quot;&gt;有自己的文件与浏览器会话&lt;br&gt;可供研究、文档与软件工作&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="400" width="400" height="180" />
        </mxCell>
        <mxCell id="connected" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;连接的用户电脑〔官方〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:24px;line-height:1.45;color:#52647A&quot;&gt;需连接授权与设备在线&lt;br&gt;不是自有云电脑的同一工作区&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="400" width="400" height="180" />
        </mxCell>
        <mxCell id="codex" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;Codex 云任务〔官方〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:24px;line-height:1.45;color:#52647A&quot;&gt;可使用准备好的仓库环境&lt;br&gt;不能据此认定与桌面同镜像&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
