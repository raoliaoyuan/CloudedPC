  <diagram id="03-storage-evidence" name="图 3-1  存储视图与容量统计疑点">
    <mxGraphModel dx="1400" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5&quot;&gt;图 3-1  存储视图与容量统计疑点&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#16324F;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="41" width="1300" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;line-height:1.5&quot;&gt;蓝色：记录值；橙色虚线：待解释或未确认；计算结果只用于核对口径&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="85" width="1300" height="30" />
        </mxCell>
        <mxCell id="accent" value="" style="rounded=1;fillColor=#137B77;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="42" width="7" height="38" />
        </mxCell>
        <mxCell id="overlay" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;工作区文件系统 overlay〔记录〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;不能据此确定底层物理盘或容器产品&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="330" y="175" width="740" height="110" />
        </mxCell>
        <mxCell id="capacity" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;总量与可用量〔记录〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:28px;line-height:1.45;color:#52647A&quot;&gt;总量约 62.94 GiB&lt;br&gt;可用约 59.54 GiB&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="390" width="600" height="160" />
        </mxCell>
        <mxCell id="used" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;已用量〔记录〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:28px;line-height:1.45;color:#52647A&quot;&gt;约 195 MiB；约 1%&lt;br&gt;未取得同一时刻的原始字节数&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="730" y="390" width="600" height="160" />
        </mxCell>
        <mxCell id="difference" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;差额口径待解释〔复核计算〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:25px;line-height:1.45;color:#52647A&quot;&gt;62.94 − 59.54 = 3.40 GiB，约 3,482 MiB&lt;br&gt;与“已用 195 MiB”不能直接对齐&lt;br&gt;保留空间、统计字段或上下文差异均只是候选解释&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="250" y="665" width="900" height="170" />
        </mxCell>
        <mxCell id="view1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#64788C;strokeWidth=2.3;endArrow=none;endFill=1;exitX=0.3108108108108108;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="overlay" target="capacity">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="560" y="335" />
              <mxPoint x="370" y="335" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="view2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#64788C;strokeWidth=2.3;endArrow=none;endFill=1;exitX=0.6891891891891891;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="overlay" target="used">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="840" y="335" />
              <mxPoint x="1030" y="335" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="calc1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.3111111111111111;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="capacity" target="difference">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="370" y="610" />
              <mxPoint x="530" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="calc2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.6888888888888889;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="used" target="difference">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1030" y="610" />
              <mxPoint x="870" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="tmpfs" value="&lt;div style=&quot;line-height:1.5&quot;&gt;tmpfs 的各约 4.87 GiB 是上限，不可相加为额外 RAM。&lt;br&gt;SSD / NVMe、IOPS、独享容量与数据保留承诺均未确认。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
