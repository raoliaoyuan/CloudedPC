<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="07-persistence-lifecycle" name="图 8-1  状态保留与持续运行的区别">
    <mxGraphModel dx="1400" dy="1190" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1190" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5&quot;&gt;图 8-1  状态保留与持续运行的区别&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#16324F;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="41" width="1300" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;line-height:1.5&quot;&gt;青色：官方能力；橙色虚线：本实例仍需核验；箭头为状态逻辑，不是时间 SLA&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="85" width="1300" height="30" />
        </mxCell>
        <mxCell id="accent" value="" style="rounded=1;fillColor=#137B77;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="42" width="7" height="38" />
        </mxCell>
        <mxCell id="objects" value="必须分别核验的对象〔支持保留状态，不代表以下项目全有相同保证〕" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=26;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="440" width="1260" height="360" />
        </mxCell>
        <mxCell id="working" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;使用时段 A〔官方能力〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:27px;line-height:1.45;color:#52647A&quot;&gt;云电脑具有自己的文件&lt;br&gt;软件与浏览器会话&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="185" width="580" height="150" />
        </mxCell>
        <mxCell id="later" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;后续使用时段 B〔官方能力〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:27px;line-height:1.45;color:#52647A&quot;&gt;可跨使用时段保留状态&lt;br&gt;安全文档说明跨会话快照&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="750" y="185" width="580" height="150" />
        </mxCell>
        <mxCell id="files" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;文件与目录&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:23px;line-height:1.45;color:#52647A&quot;&gt;具体路径、保留期限&lt;br&gt;恢复后哈希是否一致&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="objects">
          <mxGeometry as="geometry" x="30" y="95" width="350" height="200" />
        </mxCell>
        <mxCell id="cookies" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;浏览器登录态&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:23px;line-height:1.45;color:#52647A&quot;&gt;可能受网站会话失效影响&lt;br&gt;与文件快照不是同一对象&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="objects">
          <mxGeometry as="geometry" x="455" y="95" width="350" height="200" />
        </mxCell>
        <mxCell id="process" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;进程与网络连接&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:23px;line-height:1.45;color:#52647A&quot;&gt;进程、监听端口、TCP 会话&lt;br&gt;是否继续或恢复仍未知&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="objects">
          <mxGeometry as="geometry" x="880" y="95" width="350" height="200" />
        </mxCell>
        <mxCell id="policy" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;适用账号策略〔未确认〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:25px;line-height:1.45;color:#52647A&quot;&gt;企业条件化保留规则不能直接套用&lt;br&gt;不能承诺统一文件寿命或永久保存&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="915" width="600" height="145" />
        </mxCell>
        <mxCell id="backup" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;独立副本与恢复演练〔建议〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;源码和交付物保留独立副本&lt;br&gt;恢复成功仅证明该次情景&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="730" y="915" width="600" height="145" />
        </mxCell>
        <mxCell id="continuity" style="edgeStyle=none;rounded=0;html=1;strokeColor=#137B77;strokeWidth=2.3;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="working" target="later">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="source" value="&lt;div style=&quot;line-height:1.5&quot;&gt;来源：[O1][O2]；[A #039、#042]。状态延续不等于任意后台服务不间断运行。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1125" width="1280" height="45" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
