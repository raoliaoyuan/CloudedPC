<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="02-resource-limits" name="图 2-1  可见资源与实际配额核验">
    <mxGraphModel dx="1400" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5&quot;&gt;图 2-1  可见资源与实际配额核验&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#16324F;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="41" width="1300" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;line-height:1.5&quot;&gt;蓝色：历史助手记录；橙色虚线：缺失证据；灰色：通用技术解释&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="85" width="1300" height="30" />
        </mxCell>
        <mxCell id="accent" value="" style="rounded=1;fillColor=#137B77;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="42" width="7" height="38" />
        </mxCell>
        <mxCell id="technical" value="通用 cgroup v2 机制〔技术说明，不是 Dot 已测配置〕" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=26;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="765" width="1260" height="215" />
        </mxCell>
        <mxCell id="cpu" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;CPU 可见值〔记录〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:27px;line-height:1.45;color:#52647A&quot;&gt;AMD EPYC 9V74 型号字符串&lt;br&gt;9 个逻辑 CPU；允许 CPU 0–8&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="190" width="600" height="170" />
        </mxCell>
        <mxCell id="memory" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;内存可见值〔记录〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:27px;line-height:1.45;color:#52647A&quot;&gt;总量约 9.73 GiB&lt;br&gt;当时已用 1.64 GiB；可用 8.09 GiB&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="730" y="190" width="600" height="170" />
        </mxCell>
        <mxCell id="cpu-limit" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;CPU 实际限制〔未确认〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;缺少 cpu.max 与可读父层限制&lt;br&gt;也未完成独占性与持续性能验证&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="485" width="600" height="170" />
        </mxCell>
        <mxCell id="memory-limit" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;内存硬限制〔未确认〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;缺少 memory.max 与可读父层限制&lt;br&gt;可见总量不自动等于允许使用上限&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="730" y="485" width="600" height="170" />
        </mxCell>
        <mxCell id="cpu-check" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="cpu" target="cpu-limit">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="cpu-check-label" value="需补证据，不能直接换算" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#176B99;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="239.0" y="405" width="262.0" height="28" />
        </mxCell>
        <mxCell id="mem-check" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="memory" target="memory-limit">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="mem-check-label" value="需补证据，不能直接等同" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#176B99;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="899.0" y="405" width="262.0" height="28" />
        </mxCell>
        <mxCell id="rule" value="&lt;div style=&quot;line-height:1.5&quot;&gt;CPU 时间上限 = quota / period；子级仍受父级限制。&lt;br&gt;内存须核对硬限制；若采用其他资源控制机制，应按实际实现核验。&lt;br&gt;没有原始限制与基准测试，不能认定“独占 9 核 / 10 GiB”。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="830" width="1180" height="120" />
        </mxCell>
        <mxCell id="source" value="&lt;div style=&quot;line-height:1.5&quot;&gt;来源：[A #024]；[T1] Linux cgroup v2。模型推理硬件也不能由此 CPU 视图反推。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1030" width="1280" height="55" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
