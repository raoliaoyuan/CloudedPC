        <mxCell id="view-note" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;查看不等于已接管&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:23px;line-height:1.45;color:#52647A&quot;&gt;打开画面后仍需选择 Take over&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
