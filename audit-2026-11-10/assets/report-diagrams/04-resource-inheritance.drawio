  <diagram id="04-resource-inheritance" name="图 2-1  资源视图与配额继承">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5&quot;&gt;图 2-1  资源视图与配额继承&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#16324F;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="41" width="1300" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;line-height:1.5&quot;&gt;规划任务应以可见父级 cgroup 限制为依据｜基于 2026-11-10 检查&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="85" width="1300" height="30" />
        </mxCell>
        <mxCell id="accent" value="" style="rounded=1;fillColor=#137B77;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="42" width="7" height="38" />
        </mxCell>
        <mxCell id="budget" value="本工作区的资源边界 · 子级无法突破父级限制" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=22;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="350" width="1280" height="570" />
        </mxCell>
        <mxCell id="visible" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;系统工具显示的上层资源&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;32 个逻辑 CPU / 约 123.32 GiB 内存&lt;br&gt;可见范围不代表容器独占资源&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="340" y="180" width="720" height="110" />
        </mxCell>
        <mxCell id="parent-limit" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;可见父级 cgroup&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;CPU：400000 / 100000 ≈ 4 核算力配额&lt;br&gt;内存：8 GiB；进程 / 线程数：151533&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="budget">
          <mxGeometry as="geometry" x="280" y="75" width="720" height="120" />
        </mxCell>
        <mxCell id="leaf" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;检查进程所在 init.scope&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;CPU、内存、进程数限制显示 max&lt;br&gt;仍然继承父级上限&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="budget">
          <mxGeometry as="geometry" x="280" y="275" width="720" height="110" />
        </mxCell>
        <mxCell id="platform-task" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;平台服务（示意）&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="budget">
          <mxGeometry as="geometry" x="50" y="475" width="320" height="65" />
        </mxCell>
        <mxCell id="user-task" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;项目任务（示意）&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="budget">
          <mxGeometry as="geometry" x="480" y="475" width="320" height="65" />
        </mxCell>
        <mxCell id="docker-task" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;内部 Docker 任务（示意）&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="budget">
          <mxGeometry as="geometry" x="910" y="475" width="320" height="65" />
        </mxCell>
        <mxCell id="e-reference" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="visible" target="parent-limit">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-reference-label" value="实际预算以限制值为准" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#176B99;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="605.0" y="308" width="190.0" height="28" />
        </mxCell>
        <mxCell id="e-inherit" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="parent-limit" target="leaf">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-inherit-label" value="限制沿层级向下生效" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#176B99;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="613.5" y="570" width="173.0" height="28" />
        </mxCell>
        <mxCell id="e-platform-task" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="leaf" target="platform-task">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="700" y="780" />
              <mxPoint x="270" y="780" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-user-task" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="leaf" target="user-task">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="700" y="780" />
              <mxPoint x="700" y="780" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-docker-task" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="leaf" target="docker-task">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="700" y="780" />
              <mxPoint x="1130" y="780" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="shared-note" value="&lt;div style=&quot;line-height:1.5&quot;&gt;平台服务、项目进程和内部 Docker 任务共同消耗外层配额；max 不表示无限资源。&lt;br&gt;任务分组为示意，未逐一核对所有进程及未来子容器的 cgroup 路径。&lt;br&gt;/dev/shm 的 8 GiB 容量不是额外内存；短时采样也不构成长期性能保证。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="950" width="1260" height="120" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>