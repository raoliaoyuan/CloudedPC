            <Array as="points">
              <mxPoint x="700" y="780" />
              <mxPoint x="700" y="780" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-docker-task" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="leaf" target="docker-task">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="700" y="780" />
              <mxPoint x="1130" y="780" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="shared-note" value="&lt;div style=&quot;line-height:1.5&quot;&gt;平台服务、项目进程和内部 Docker 任务共同消耗外层配额；max 不表示无限资源。&lt;br&gt;任务分组为示意，未逐一核对所有进程及未来子容器的 cgroup 路径。&lt;br&gt;/dev/shm 的 8 GiB 容量不是额外内存；短时采样也不构成长期性能保证。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="950" width="1260" height="120" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="05-storage-persistence" name="图 3-1  存储层次与持久化边界">
