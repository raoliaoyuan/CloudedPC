        <mxCell id="init" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;docker-init&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;容器 PID 1&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="work">
