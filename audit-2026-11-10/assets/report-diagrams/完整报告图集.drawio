        <mxCell id="docker-task" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;内部 Docker 任务（示意）&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="budget">
          <mxGeometry as="geometry" x="910" y="475" width="320" height="65" />
        </mxCell>
        <mxCell id="e-reference" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="visible" target="parent-limit">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-reference-label" value="实际预算以限制值为准" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#176B99;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="605.0" y="308" width="190.0" height="28" />
        </mxCell>
        <mxCell id="e-inherit" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="parent-limit" target="leaf">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-inherit-label" value="限制沿层级向下生效" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#176B99;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="613.5" y="570" width="173.0" height="28" />
        </mxCell>
        <mxCell id="e-platform-task" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="leaf" target="platform-task">
