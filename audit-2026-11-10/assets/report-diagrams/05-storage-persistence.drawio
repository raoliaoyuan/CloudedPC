<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="05-storage-persistence" name="图 3-1  存储层次与持久化边界">
    <mxGraphModel dx="1400" dy="1160" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1160" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5&quot;&gt;图 3-1  存储层次与持久化边界&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#16324F;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="41" width="1300" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;line-height:1.5&quot;&gt;实线表示已观察的路径 / 存储关联；虚线表示待平台确认的恢复能力&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="85" width="1300" height="30" />
        </mxCell>
        <mxCell id="accent" value="" style="rounded=1;fillColor=#137B77;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="42" width="7" height="38" />
        </mxCell>
        <mxCell id="observed" value="已观察的容器路径与存储结构" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=22;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="170" width="1320" height="670" />
        </mxCell>
        <mxCell id="paths" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;工作区与用户文件&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;/root / /workspace / /tmp&lt;br&gt;检查时位于根文件系统视图内&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="observed">
          <mxGeometry as="geometry" x="80" y="85" width="500" height="110" />
        </mxCell>
        <mxCell id="runtime-paths" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;内部运行时数据目录&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;/var/lib/docker / /var/lib/buildkit&lt;br&gt;以及 containerd、kubelet 等目录&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="observed">
          <mxGeometry as="geometry" x="740" y="85" width="500" height="110" />
        </mxCell>
        <mxCell id="overlay" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;根文件系统：overlay&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;可见总容量 256 GiB&lt;br&gt;采样可用约 253.79 GiB&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="observed">
          <mxGeometry as="geometry" x="80" y="300" width="500" height="120" />
        </mxCell>
        <mxCell id="runtime-store" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;运行时目录的后端挂载&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;可见平台分配目录及 idmapped 挂载&lt;br&gt;另见 /dev/nbd962 的 btrfs 后端&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="observed">
          <mxGeometry as="geometry" x="740" y="300" width="500" height="120" />
        </mxCell>
        <mxCell id="userdata" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;可写层来源线索&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;平台 user-data 路径&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="observed">
          <mxGeometry as="geometry" x="80" y="535" width="500" height="90" />
        </mxCell>
        <mxCell id="retention" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;休眠、重建、回收后的数据保留？&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;哪些路径受保护、快照周期及恢复时长&lt;br&gt;均需平台确认，并以恢复演练验收&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="400" y="940" width="600" height="110" />
        </mxCell>
        <mxCell id="e-root" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="paths" target="overlay">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-runtime" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="runtime-paths" target="runtime-store">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-data" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="overlay" target="userdata">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-retain-left" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="userdata" target="retention">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="370" y="880" />
              <mxPoint x="700" y="880" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-retain-right" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="runtime-store" target="retention">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1320" y="590" />
              <mxPoint x="1320" y="880" />
              <mxPoint x="700" y="880" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="scope-note" value="&lt;div style=&quot;line-height:1.5&quot;&gt;挂载来源是存储结构线索。&lt;br&gt;不能据此确定独占容量、数据保留周期，&lt;br&gt;也不代表相关运行时全部正在运行。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="790" y="685" width="490" height="110" />
        </mxCell>
        <mxCell id="bottom" value="&lt;div style=&quot;line-height:1.5&quot;&gt;文件同步不等于可恢复备份；磁盘设备显示值也不能直接相加为容器可用容量。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1090" width="1300" height="40" />
        </mxCell>
      </root>
    </mxGraphModel>
