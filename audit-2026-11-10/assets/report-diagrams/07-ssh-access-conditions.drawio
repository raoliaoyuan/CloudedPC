<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="07-ssh-access-conditions" name="图 7-2  OpenSSH 访问条件">
    <mxGraphModel dx="1400" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5&quot;&gt;图 7-2  OpenSSH 访问条件&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#16324F;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="41" width="1300" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;line-height:1.5&quot;&gt;箭头表示条件检查顺序，不代表已完成连接或密码认证测试&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="85" width="1300" height="30" />
        </mxCell>
        <mxCell id="accent" value="" style="rounded=1;fillColor=#137B77;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="42" width="7" height="38" />
        </mxCell>
        <mxCell id="outer" value="平台外层 · 需要平台核验" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=22;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="330" width="1280" height="160" />
        </mxCell>
        <mxCell id="inner" value="容器内部 · 已核对配置" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=22;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="545" width="1280" height="620" />
        </mxCell>
        <mxCell id="request" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;候选连接&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;连接目标：容器 OpenSSH TCP 22&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="340" y="180" width="720" height="85" />
        </mxCell>
        <mxCell id="outer-policy" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;安全组、路由、端口发布及网络策略是否允许？&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:18px;line-height:1.45;color:#52647A&quot;&gt;外层规则未取得，实际来源范围未知&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="outer">
          <mxGeometry as="geometry" x="280" y="55" width="720" height="85" />
        </mxCell>
        <mxCell id="listener" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;监听与已检查的 INPUT 规则&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;监听 0.0.0.0:22、[::]:22&lt;br&gt;已检查的 IPv4 / IPv6 INPUT 链无来源限制&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="inner">
          <mxGeometry as="geometry" x="280" y="70" width="720" height="115" />
        </mxCell>
        <mxCell id="auth" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;OpenSSH 认证及账号条件&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;root 密码认证允许；空密码禁止&lt;br&gt;还需有效凭据、账号状态、Shell 与 PAM 条件满足&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="inner">
          <mxGeometry as="geometry" x="280" y="270" width="720" height="135" />
        </mxCell>
        <mxCell id="session" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;所有条件满足后才能建立会话&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;实际密码登录及密码强度未验证&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="inner">
          <mxGeometry as="geometry" x="280" y="495" width="720" height="90" />
        </mxCell>
        <mxCell id="e-outer" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="request" target="outer-policy">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-network" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="outer-policy" target="listener">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-auth" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="listener" target="auth">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-session" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="auth" target="session">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bottom" value="&lt;div style=&quot;line-height:1.5&quot;&gt;任一条件不满足，均可能阻止会话建立；仅凭通配地址监听或容器 INPUT 为 ACCEPT，&lt;br&gt;不能认定公网可达，也不能把访问范围归结为某个已确认的网段。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1210" width="1280" height="60" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>