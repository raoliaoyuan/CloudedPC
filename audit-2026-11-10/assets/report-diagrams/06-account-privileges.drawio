<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="06-account-privileges" name="图 6-1  账号与权限关系">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5&quot;&gt;图 6-1  账号与权限关系&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#16324F;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="41" width="1300" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;line-height:1.5&quot;&gt;区分密码认证状态、容器内管理权限和外层 UID 映射｜基于 2026-11-10 检查&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="85" width="1300" height="30" />
        </mxCell>
        <mxCell id="accent" value="" style="rounded=1;fillColor=#137B77;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="42" width="7" height="38" />
        </mxCell>
        <mxCell id="container" value="容器内部权限范围" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=22;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="170" width="1300" height="640" />
        </mxCell>
        <mxCell id="root" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;root · UID 0&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:17px;line-height:1.45;color:#52647A&quot;&gt;已设置密码&lt;br&gt;OpenSSH 配置允许密码认证&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="container">
          <mxGeometry as="geometry" x="50" y="95" width="330" height="110" />
        </mxCell>
        <mxCell id="sudo-users" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;ubuntu / user&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:17px;line-height:1.45;color:#52647A&quot;&gt;UID 1000 / 1001&lt;br&gt;密码锁定；未发现授权公钥&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="container">
          <mxGeometry as="geometry" x="50" y="295" width="330" height="135" />
        </mxCell>
        <mxCell id="admin" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;容器内 root 管理权限&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;可管理容器文件、账号、软件及服务&lt;br&gt;权限仍受外层隔离约束&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="container">
          <mxGeometry as="geometry" x="550" y="130" width="650" height="130" />
        </mxCell>
        <mxCell id="system" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;其他系统账号&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;dockremap / nova / sync：未发现 sudo 权限&lt;br&gt;另有 21 个禁止登录或不可交互用途账号&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="container">
          <mxGeometry as="geometry" x="550" y="445" width="650" height="125" />
        </mxCell>
        <mxCell id="mapping" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.3&quot;&gt;user namespace 映射&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:19px;line-height:1.45;color:#52647A&quot;&gt;容器 UID 0 → 直接外层 UID 100000&lt;br&gt;不能由此获得外层 UID 0 的权限&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="910" width="650" height="100" />
        </mxCell>
        <mxCell id="e-root" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.15384615384615385;entryPerimeter=0;" edge="1" parent="1" source="root" target="admin">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-sudo" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=1.0;exitY=0.4962962962962963;exitPerimeter=0;entryX=0.0;entryY=0.6923076923076923;entryPerimeter=0;" edge="1" parent="1" source="sudo-users" target="admin">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="500" y="532" />
              <mxPoint x="500" y="390" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-sudo-label" value="NOPASSWD: ALL" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#176B99;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="434.75" y="425" width="130.5" height="28" />
        </mxCell>
        <mxCell id="e-map" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="admin" target="mapping">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1320" y="365" />
              <mxPoint x="1320" y="860" />
              <mxPoint x="925" y="860" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-map-label" value="映射关系，不是登录或提权路径" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#176B99;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="971.0" y="845" width="258.0" height="28" />
        </mxCell>
        <mxCell id="sudo-explain" value="&lt;div style=&quot;line-height:1.5&quot;&gt;ubuntu / user 不构成可靠的低权限执行边界。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="465" width="650" height="55" />
        </mxCell>
        <mxCell id="locked-note" value="&lt;div style=&quot;line-height:1.5&quot;&gt;密码锁定限制密码认证，&lt;br&gt;不等于账号不能被平台进程使用。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="650" width="410" height="85" />
        </mxCell>
        <mxCell id="bottom" value="&lt;div style=&quot;line-height:1.5&quot;&gt;建议执行项目代码时使用无免密码 sudo、无不必要 capabilities 和管理 socket 权限的独立账号。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1040" width="1280" height="40" />
        </mxCell>
