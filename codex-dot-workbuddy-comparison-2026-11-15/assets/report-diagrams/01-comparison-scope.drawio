        <mxCell id="wb" value="WorkBuddy 云 PC 本实例" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=26;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="730" y="175" width="620" height="660" />
        </mxCell>
        <mxCell id="dot-official" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;任务与云电脑〔官方〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;Dot 有自有云电脑与浏览器&lt;br&gt;可委派任务并由用户必要时接管&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="dot">
          <mxGeometry as="geometry" x="35" y="90" width="550" height="150" />
        </mxCell>
        <mxCell id="dot-evidence" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;实例证据〔记录与观察〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;配置多为历史助手陈述&lt;br&gt;数独可玩与 GUI 操作有用户确认&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="dot">
          <mxGeometry as="geometry" x="35" y="290" width="550" height="145" />
        </mxCell>
        <mxCell id="dot-unknown" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;部署细节〔未确认〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;运行时、配额、底层拓扑&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="dot">
          <mxGeometry as="geometry" x="35" y="485" width="550" height="125" />
        </mxCell>
        <mxCell id="wb-evidence" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;Tencent Cloud CVM〔实测线索〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;DMI 厂商与产品标识&lt;br&gt;当前工作区是 Linux 容器&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="wb">
          <mxGeometry as="geometry" x="35" y="90" width="550" height="150" />
        </mxCell>
        <mxCell id="wb-service" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;容器内管理〔历史实测〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;终端、CodeBuddy 与 Docker 组件&lt;br&gt;有配置、进程和访问证据&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="wb">
          <mxGeometry as="geometry" x="35" y="290" width="550" height="145" />
        </mxCell>
        <mxCell id="wb-boundary" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;宿主能力〔未确认〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:24px;line-height:1.45;color:#52647A&quot;&gt;Sysbox 特征是推断；无宿主管理权&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="wb">
          <mxGeometry as="geometry" x="35" y="485" width="550" height="125" />
        </mxCell>
        <mxCell id="rules" value="&lt;div style=&quot;line-height:1.5&quot;&gt;Dot 自有云电脑、委派的 Codex Cloud 与连接的个人电脑不能混为同一环境。&lt;br&gt;两边都涉及代理工具；本图不比较代理模型质量，也不把单个实例泛化为产品规格。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
