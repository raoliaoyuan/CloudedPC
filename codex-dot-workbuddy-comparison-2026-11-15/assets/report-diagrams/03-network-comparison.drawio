        </mxCell>
        <mxCell id="wb" value="WorkBuddy 本实例" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=26;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="170" width="620" height="740" />
        </mxCell>
        <mxCell id="dot" value="Codex Dot 云电脑" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=26;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="730" y="170" width="620" height="740" />
        </mxCell>
        <mxCell id="wb-user" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;用户端发起远程访问&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;历史 SSH 登录成功&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="wb">
          <mxGeometry as="geometry" x="40" y="90" width="540" height="110" />
        </mxCell>
        <mxCell id="wb-entry" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;Tailscale 入口〔历史实测〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:25px;line-height:1.45;color:#52647A&quot;&gt;用户态模式在线&lt;br&gt;此处不等同于容器 OpenSSH&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="wb">
          <mxGeometry as="geometry" x="40" y="280" width="540" height="145" />
        </mxCell>
        <mxCell id="wb-target" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;WorkBuddy 执行环境&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;可开展已授权的终端管理&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="wb">
          <mxGeometry as="geometry" x="40" y="490" width="540" height="115" />
        </mxCell>
        <mxCell id="dot-user" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;用户操作 GUI〔用户观察〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;可操作，但反馈体验差&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="dot">
          <mxGeometry as="geometry" x="40" y="90" width="540" height="110" />
        </mxCell>
        <mxCell id="dot-entry" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;人工接管〔官方〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:25px;line-height:1.45;color:#52647A&quot;&gt;查看后选择 Take over&lt;br&gt;GUI 协议与传输路径未确认&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="dot">
          <mxGeometry as="geometry" x="40" y="280" width="540" height="145" />
        </mxCell>
        <mxCell id="dot-target" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;Dot 云电脑&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;用户确认数独本地预览可玩&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="dot">
          <mxGeometry as="geometry" x="40" y="490" width="540" height="115" />
        </mxCell>
        <mxCell id="unknown" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;两边仍须分别验收&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:25px;line-height:1.45;color:#52647A&quot;&gt;公网入站、长期服务与恢复；Dot 另缺独立 SSH 及尾网连接证据&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="960" width="1200" height="120" />
        </mxCell>
