        <mxCell id="dot2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#137B77;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="dot-entry" target="dot-target">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="wb-note" value="&lt;div style=&quot;line-height:1.5&quot;&gt;独立探测经 DERP(sin)，均值 104.6 ms&lt;br&gt;不是该次 SSH 的完整抓包或 GUI 测量&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="95" y="810" width="530" height="70" />
        </mxCell>
        <mxCell id="dot-note" value="&lt;div style=&quot;line-height:1.5&quot;&gt;浏览器出站代理另有配置记录&lt;br&gt;不能把它画成已确认的 GUI 传输链&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
