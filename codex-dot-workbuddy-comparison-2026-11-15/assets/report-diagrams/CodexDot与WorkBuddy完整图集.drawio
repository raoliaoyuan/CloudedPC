        </mxCell>
        <mxCell id="wb" value="WorkBuddy 本实例" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=26;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
