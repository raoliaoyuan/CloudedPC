        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5&quot;&gt;图 6  GUI 体验问题的定位逻辑&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#16324F;fontStyle=1;spacing=0;" vertex="1" parent="1">
