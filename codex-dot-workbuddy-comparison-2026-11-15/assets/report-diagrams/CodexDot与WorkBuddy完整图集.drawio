      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5&quot;&gt;图 1  比较对象与证据边界&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#16324F;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="41" width="1300" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;line-height:1.5&quot;&gt;逻辑范围图｜蓝色：历史资料，等级见框内；青色：官方；橙色虚线：未确认&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="85" width="1300" height="30" />
        </mxCell>
        <mxCell id="accent" value="" style="rounded=1;fillColor=#137B77;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="42" width="7" height="38" />
        </mxCell>
        <mxCell id="dot" value="Codex Dot 云电脑" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=26;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="175" width="620" height="660" />
        </mxCell>
        <mxCell id="wb" value="WorkBuddy 云 PC 本实例" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=26;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="730" y="175" width="620" height="660" />
        </mxCell>
        <mxCell id="dot-official" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;任务与云电脑〔官方〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;Dot 有自有云电脑与浏览器&lt;br&gt;可委派任务并由用户必要时接管&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="dot">
          <mxGeometry as="geometry" x="35" y="90" width="550" height="150" />
        </mxCell>
        <mxCell id="dot-evidence" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;实例证据〔记录与观察〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;配置多为历史助手陈述&lt;br&gt;数独可玩与 GUI 操作有用户确认&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="dot">
          <mxGeometry as="geometry" x="35" y="290" width="550" height="145" />
        </mxCell>
        <mxCell id="dot-unknown" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;部署细节〔未确认〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;运行时、配额、底层拓扑&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="dot">
          <mxGeometry as="geometry" x="35" y="485" width="550" height="125" />
        </mxCell>
        <mxCell id="wb-evidence" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;Tencent Cloud CVM〔实测线索〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;DMI 厂商与产品标识&lt;br&gt;当前工作区是 Linux 容器&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="wb">
          <mxGeometry as="geometry" x="35" y="90" width="550" height="150" />
        </mxCell>
        <mxCell id="wb-service" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;容器内管理〔历史实测〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;终端、CodeBuddy 与 Docker 组件&lt;br&gt;有配置、进程和访问证据&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="wb">
          <mxGeometry as="geometry" x="35" y="290" width="550" height="145" />
        </mxCell>
        <mxCell id="wb-boundary" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;宿主能力〔未确认〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:24px;line-height:1.45;color:#52647A&quot;&gt;Sysbox 特征是推断；无宿主管理权&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="wb">
          <mxGeometry as="geometry" x="35" y="485" width="550" height="125" />
        </mxCell>
        <mxCell id="rules" value="&lt;div style=&quot;line-height:1.5&quot;&gt;Dot 自有云电脑、委派的 Codex Cloud 与连接的个人电脑不能混为同一环境。&lt;br&gt;两边都涉及代理工具；本图不比较代理模型质量，也不把单个实例泛化为产品规格。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="880" width="1260" height="95" />
        </mxCell>
        <mxCell id="source" value="&lt;div style=&quot;line-height:1.5&quot;&gt;来源：[W1 第 2、5、8 章][A #024、#060][U1][O1][O3]。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="990" width="1280" height="40" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="02-resource-comparison" name="图 2  可见资源与实际限制">
    <mxGraphModel dx="1400" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5&quot;&gt;图 2  可见资源与实际限制&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#16324F;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="41" width="1300" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;line-height:1.5&quot;&gt;蓝色：历史实测或记录；橙色虚线：需补证据；同口径后才能比较&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="85" width="1300" height="30" />
        </mxCell>
        <mxCell id="accent" value="" style="rounded=1;fillColor=#137B77;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="42" width="7" height="38" />
        </mxCell>
        <mxCell id="dot-view" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;Dot 可见视图〔记录〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:28px;line-height:1.45;color:#52647A&quot;&gt;9 个逻辑 CPU&lt;br&gt;内存总量约 9.73 GiB&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="190" width="600" height="160" />
        </mxCell>
        <mxCell id="wb-view" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;WorkBuddy 可见视图〔实测〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:28px;line-height:1.45;color:#52647A&quot;&gt;32 个逻辑 CPU&lt;br&gt;内存总量约 123.32 GiB&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="730" y="190" width="600" height="160" />
        </mxCell>
        <mxCell id="dot-limit" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;实际限制〔未确认〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;缺少 cpu.max、memory.max&lt;br&gt;或其他资源控制机制的原始证据&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="500" width="600" height="165" />
        </mxCell>
        <mxCell id="wb-limit" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;父级限制〔历史实测〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;400000 / 100000 → 4 核时间上限&lt;br&gt;memory.max → 8 GiB 硬限制&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="730" y="500" width="600" height="165" />
        </mxCell>
        <mxCell id="conclusion" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;比较结论〔技术分析〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:27px;line-height:1.45;color:#52647A&quot;&gt;9 个可见 CPU 与 4 核时间上限不是同一种指标&lt;br&gt;没有同负载基准，不能据此排名性能、独占性或响应速度&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="140" y="800" width="1120" height="145" />
        </mxCell>
        <mxCell id="dot-check" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="dot-view" target="dot-limit">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="dot-check-label" value="不能直接当成配额" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#176B99;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="272.0" y="410" width="196.0" height="28" />
        </mxCell>
        <mxCell id="wb-check" style="edgeStyle=none;rounded=0;html=1;strokeColor=#176B99;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="wb-view" target="wb-limit">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="wb-check-label" value="实际核对父级约束" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#176B99;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="932.0" y="410" width="196.0" height="28" />
        </mxCell>
        <mxCell id="source" value="&lt;div style=&quot;line-height:1.5&quot;&gt;来源：[A #024][W1 第 2 章][T1]。4 核上限不是 4 个独占物理核，也不是保底性能。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1000" width="1280" height="50" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
