          <mxGeometry as="geometry" x="40" y="420" width="540" height="110" />
        </mxCell>
        <mxCell id="return" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;Return control&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;交还后由 Dot 继续任务&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="left">
          <mxGeometry as="geometry" x="40" y="585" width="540" height="110" />
        </mxCell>
        <mxCell id="terminal" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;终端与预览组件〔实测〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;平台终端、editor-sdk 运行&lt;br&gt;VS Code 配置按需启动&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="right">
          <mxGeometry as="geometry" x="40" y="90" width="540" height="155" />
        </mxCell>
        <mxCell id="desktop" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;完整桌面〔未验收〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:25px;line-height:1.45;color:#52647A&quot;&gt;有相关软件包不等于运行会话&lt;br&gt;不能直接视为 Dot 的 GUI 替代品&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="right">
          <mxGeometry as="geometry" x="40" y="330" width="540" height="170" />
        </mxCell>
        <mxCell id="same-test" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;同场景 GUI 对照〔缺失〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:24px;line-height:1.45;color:#52647A&quot;&gt;没有足够证据评定哪边更好用&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="right">
          <mxGeometry as="geometry" x="40" y="585" width="540" height="110" />
        </mxCell>
        <mxCell id="opentake" style="edgeStyle=none;rounded=0;html=1;strokeColor=#137B77;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="open" target="take">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="takeact" style="edgeStyle=none;rounded=0;html=1;strokeColor=#137B77;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="take" target="act">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="actreturn" style="edgeStyle=none;rounded=0;html=1;strokeColor=#137B77;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="act" target="return">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="meaning" value="&lt;div style=&quot;line-height:1.5&quot;&gt;〔推断〕交接流程支持“围绕代理任务组织交互”的解释。&lt;br&gt;它不能证明界面简陋是刻意设计，或安全、成本与代理工作的必要代价。&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
