        <mxCell id="terminal" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;终端与预览组件〔实测〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;平台终端、editor-sdk 运行&lt;br&gt;VS Code 配置按需启动&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="right">
