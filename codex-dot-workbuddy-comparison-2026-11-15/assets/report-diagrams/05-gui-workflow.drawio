        <mxCell id="desktop" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;完整桌面〔未验收〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:25px;line-height:1.45;color:#52647A&quot;&gt;有相关软件包不等于运行会话&lt;br&gt;不能直接视为 Dot 的 GUI 替代品&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="right">
