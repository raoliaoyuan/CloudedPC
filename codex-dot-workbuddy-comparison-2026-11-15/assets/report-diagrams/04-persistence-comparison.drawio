<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="04-persistence-comparison" name="图 4  数据保留与恢复的比较">
    <mxGraphModel dx="1400" dy="1110" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1110" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5&quot;&gt;图 4  数据保留与恢复的比较&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#16324F;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="41" width="1300" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;line-height:1.5&quot;&gt;蓝色：历史存储或服务证据；青色：官方能力；橙色：待验证对象&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#52647A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="85" width="1300" height="30" />
        </mxCell>
        <mxCell id="accent" value="" style="rounded=1;fillColor=#137B77;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="42" width="7" height="38" />
        </mxCell>
        <mxCell id="objects" value="两边都需要按对象与生命周期事件核验" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#A9BED0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=24;spacingTop=16;fontFamily=Noto Sans CJK SC;fontSize=26;fontStyle=1;fontColor=#16324F;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="450" width="1260" height="320" />
        </mxCell>
        <mxCell id="dot" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;Dot 状态延续〔官方〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:27px;line-height:1.45;color:#52647A&quot;&gt;可跨使用时段保留状态&lt;br&gt;本账号的具体策略尚未核实&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF8F5;strokeColor=#137B77;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="190" width="600" height="150" />
        </mxCell>
        <mxCell id="wb" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;WorkBuddy 存储与同步〔实测〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:27px;line-height:1.45;color:#52647A&quot;&gt;user-data 与后端挂载线索&lt;br&gt;同步组件运行，完整性尚未验收&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FB;strokeColor=#176B99;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="730" y="190" width="600" height="150" />
        </mxCell>
        <mxCell id="files" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;文件与目录&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:24px;line-height:1.45;color:#52647A&quot;&gt;路径和哈希&lt;br&gt;暂停或重建后是否恢复&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="objects">
          <mxGeometry as="geometry" x="30" y="95" width="350" height="175" />
        </mxCell>
        <mxCell id="browser" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;浏览器会话&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:24px;line-height:1.45;color:#52647A&quot;&gt;是否已登录&lt;br&gt;网站过期与快照分别看&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="objects">
          <mxGeometry as="geometry" x="455" y="95" width="350" height="175" />
        </mxCell>
        <mxCell id="process" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;进程与连接&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:24px;line-height:1.45;color:#52647A&quot;&gt;进程、端口与 TCP&lt;br&gt;是否继续或需要重建&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="objects">
          <mxGeometry as="geometry" x="880" y="95" width="350" height="175" />
        </mxCell>
        <mxCell id="backup" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;独立副本与恢复演练〔建议〕&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;状态保留不等于进程持续运行；文件同步不等于可恢复备份&lt;br&gt;当前没有一方完成本项目所需的完整恢复验收&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="160" y="870" width="1080" height="135" />
        </mxCell>
        <mxCell id="dot-test" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.23809523809523808;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="dot" target="objects">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="wb-test" style="edgeStyle=none;rounded=0;html=1;strokeColor=#A86C16;strokeWidth=2.3;endArrow=block;endFill=1;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.7619047619047619;entryY=0.0;entryPerimeter=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="wb" target="objects">
          <mxGeometry as="geometry" relative="1" />
