        <mxCell id="layout" value="&lt;div style=&quot;font-size:28px;font-weight:bold;line-height:1.3&quot;&gt;找不到或不理解操作&lt;/div&gt;&lt;div style=&quot;margin-top:9px;font-size:26px;line-height:1.45;color:#52647A&quot;&gt;检查入口、状态反馈与步骤&lt;br&gt;记录任务用时、误操作和恢复路径&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#A86C16;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontColor=#16324F;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
